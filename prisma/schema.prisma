generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  image       String?
  year        String?
  branch      String?
  bio         String?
  githubUrl   String?
  linkedinUrl String?
  lookingFor  String?
  skills      String[]

  // People-directory profile fields
  role            String?
  openTo          String[]
  yearsExperience Int?
  location        String?

  // GitHub enrichment cache (avatar reuses `image`)
  githubBio      String?
  githubRepos    Json?
  githubFetchedAt DateTime?

  createdAt DateTime @default(now())

  posts           Post[]
  requests        JoinRequest[]
  sentConnects    ConnectRequest[] @relation("sentConnects")
  receivedConnects ConnectRequest[] @relation("receivedConnects")
}

enum PostType {
  hackathon
  project
}

enum PostStatus {
  open
  closed
}

enum RequestStatus {
  pending
  accepted
  declined
}

model Post {
  id           String     @id @default(cuid())
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type          PostType
  title         String
  hackathonName String?
  description   String
  expecting     String?
  neededSkills String[]
  teamSize     Int
  happeningAt  DateTime?
  status       PostStatus @default(open)
  createdAt    DateTime   @default(now())

  requests JoinRequest[]
}

model JoinRequest {
  id          String        @id @default(cuid())
  postId      String
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  message     String
  status      RequestStatus @default(pending)
  createdAt   DateTime      @default(now())

  @@unique([postId, requesterId])
}

// Person-to-person connect (people directory). Mirrors JoinRequest.
model ConnectRequest {
  id        String        @id @default(cuid())
  fromId    String
  from      User          @relation("sentConnects", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User          @relation("receivedConnects", fields: [toId], references: [id], onDelete: Cascade)
  message   String
  status    RequestStatus @default(pending)
  createdAt DateTime      @default(now())

  @@unique([fromId, toId])
}
